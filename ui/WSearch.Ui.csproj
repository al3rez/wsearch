<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>WSearch.Ui</AssemblyName>
    <RootNamespace>WSearch.Ui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wsearch.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);term/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\wsearch.ico" />
  </ItemGroup>
</Project>
